# TerraShield Environment Variables

# Supabase (provisioned)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# JKUAT Conduit Weather Station API
# These credentials must be set in .env.local or your deployment environment.
# NEVER commit real credentials to version control.
CONDUIT_API_URL=https://conduit.jhubafrica.com/data.php
CONDUIT_API_KEY=
CONDUIT_EMAIL=
CONDUIT_ENABLED=true

# Set to "conduit" to use real JKUAT Conduit observations, or "demo" for synthetic data.
CLIMATE_DATA_PROVIDER=conduit
